{
  "name": "astro-whono",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cxro/astro-whono.git"
  },
  "bugs": {
    "url": "https://github.com/cxro/astro-whono/issues"
  },
  "homepage": "https://astro.whono.me",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:admin": "npm run dev --prefix apps/admin -- --host 127.0.0.1",
    "build": "node ./scripts/sync-admin-r2-content.mjs && node ./scripts/commit-admin-content.mjs && astro build",
    "build:astro": "astro build",
    "build:admin": "npm run build --prefix apps/admin",
    "build:all": "npm run build && npm run build:admin",
    "content:sync:admin": "node ./scripts/sync-admin-r2-content.mjs",
    "preview": "astro preview",
    "preview:admin": "npm run preview --prefix apps/admin",
    "check": "astro check",
    "check:admin": "npm run check --prefix apps/admin",
    "test": "vitest run --config ./vitest.config.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "check:callout": "node ./scripts/check-callout.mjs",
    "check:codeblock": "node ./scripts/check-codeblock.mjs",
    "check:figure": "node ./scripts/check-figure.mjs",
    "check:gallery": "node ./scripts/check-gallery.mjs",
    "check:prod-artifacts": "node ./scripts/check-production-artifacts.mjs",
    "check:preview-admin": "node ./scripts/check-preview-admin-boundary.mjs",
    "ci:core": "npm run check && npm run test && npm run build && npm run check:callout && npm run check:codeblock && npm run check:gallery && npm run check:figure",
    "ci:admin": "npm run build:admin",
    "ci": "npm run ci:core",
    "ci:all": "npm run ci:core && npm run ci:admin",
    "admin:install": "npm ci --prefix apps/admin",
    "admin:deploy": "npm run deploy --prefix apps/admin",
    "deploy:all": "npm run build && npm run admin:deploy",
    "font:charset": "node ./scripts/font-charset.mjs",
    "font:subset": "node ./scripts/font-subset.mjs",
    "font:build": "npm run font:charset && npm run font:subset",
    "new:bit": "node ./scripts/new-bit.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@waline/client": "^3.1.11",
    "artalk": "^2.9.1",
    "astro": "^7.0.0",
    "twikoo": "^1.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@iconify-json/logos": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "@types/node": "^22.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "ajv": "8.18.0",
    "devalue": "5.6.4",
    "fast-xml-parser": "5.5.7",
    "h3": "1.15.9",
    "rollup": "4.59.0",
    "svgo": "4.0.1",
    "volar-service-yaml": "0.0.70",
    "yaml-language-server": "1.20.0"
  }
}
