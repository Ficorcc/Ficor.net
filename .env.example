# ============================================================================
# 环境变量示例
#
# 复制成 .env 后按需填写（.env 已被 gitignore，本文件会被跟踪）。
#
# 本地开发**通常什么都不用填**：没有 R2 凭据时，同步脚本会自动回退到
# wrangler/miniflare 落在磁盘上的本地模拟 R2，`npm run dev` 即可正常跑通。
#
# 这里的变量主要给「生产构建」用。主站由 Cloudflare Pages 构建，
# 请在 Pages 项目的 Settings → Environment variables 里配置同样的键值，
# 而不是把 .env 提交上去。
#
# 完整机制说明见 apps/admin/docs/CONTENT-SYNC.md 与 apps/admin/docs/DEPLOY.md。
# ============================================================================


# ----------------------------------------------------------------------------
# 1. R2 内容源（生产构建必需）
#
# 三个都配齐才会启用远端源；缺任何一个都会回退到本地模拟 R2，
# 本地没有模拟存储时则「静默跳过同步」（用 ADMIN_R2_SYNC_STRICT=1 可改为报错）。
#
# 凭据在 Cloudflare Dashboard → R2 → Manage R2 API Tokens 创建，
# 权限需要 Object Read & Write，作用于 admin-r2 桶。
# ----------------------------------------------------------------------------
ADMIN_R2_ACCOUNT_ID=
ADMIN_R2_ACCESS_KEY_ID=
ADMIN_R2_SECRET_ACCESS_KEY=

# 桶名与前缀（留空即用下面这些默认值）
# ADMIN_R2_BUCKET=admin-r2
# ADMIN_R2_PREFIX=content/
# ADMIN_R2_SETTINGS_PREFIX=settings/
# ADMIN_R2_DATA_PREFIX=data/


# ----------------------------------------------------------------------------
# 2. 内容回写 GitHub（生产构建建议配置）
#
# 构建流程是：同步 R2 → 仓库  →  把差异提交并推回 main  →  astro build。
# 没有这个 token，第三步静默跳过：本次构建能看到后台内容，但仓库不会被更新，
# 下次构建又会重新拉一遍。PAT 需要 Contents: Read and write。
#
# 注意：确认回写是否真的生效，用
#   git log --format='%an | %s' | grep -i "vii-ink-bot"
# 一直为空说明凭据没配或同步结果无变化。
# ----------------------------------------------------------------------------
GITHUB_CONTENT_PUSH_TOKEN=
# GITHUB_CONTENT_REPO=Ficorcc/Ficor.net
# GITHUB_BRANCH=main          # Cloudflare Pages 会注入 CF_PAGES_BRANCH，通常无需设置


# ----------------------------------------------------------------------------
# 3. 站点地址
# ----------------------------------------------------------------------------
# 生产构建必填：影响 canonical / og:url / sitemap / robots / RSS。
# 不填时 NODE_ENV=production 会告警，RSS 退化成 example.invalid。
SITE_URL=https://vii.ink

# 后台入口地址，显示在站点导航等处
# ADMIN_URL=https://vii.ink/admin


# ----------------------------------------------------------------------------
# 4. 同步行为调优（一般不需要动）
# ----------------------------------------------------------------------------
# 强制指定内容源：auto（默认）/ remote / local
# ADMIN_R2_SOURCE=auto

# 本地模拟 R2 根目录，默认 apps/admin/.wrangler/state/v3
# ADMIN_R2_LOCAL_STATE=

# 冲突策略：skip / overwrite
#   默认 overwrite —— R2 是唯一真源，本地与生产同一套逻辑。
#   被覆盖的文件会在同步结束时逐个列出；想先人工确认再落盘就设成 skip，
#   或先跑一次 `npm run content:sync -- --dry-run`。
# ADMIN_R2_SYNC_ON_CONFLICT=

# =1 时删除仓库里「R2 已不存在」的文章。
# ⚠️ 不要只给生产打开：仓库里直接以 Markdown 提交、尚未导入后台的文章会被
#    构建删除并提交回 main，而本地默认关闭 —— 两端行为就此分叉。
#    需要下架文章请用后台删除（写墓碑，本地与生产一致生效）。
# ADMIN_R2_SYNC_PRUNE=

# =1 时找不到内容源直接让构建失败，而不是告警跳过。
# 想让「凭据没配」这种问题暴露出来时打开。
# ADMIN_R2_SYNC_STRICT=


# ----------------------------------------------------------------------------
# 5. 本地开发监听（npm run dev / npm run content:watch）
# ----------------------------------------------------------------------------
# 轮询间隔，毫秒
# ADMIN_WATCH_INTERVAL=2000

# 透传给同步脚本的额外参数，例如 --dry-run
# ADMIN_WATCH_SYNC_ARGS=

# npm run content:push 写入本地模拟 R2 前的备份目录，默认系统临时目录
# ADMIN_PUSH_BACKUP_DIR=


# ----------------------------------------------------------------------------
# 6. 后台 Worker（apps/admin）
# ----------------------------------------------------------------------------
# 后台自己的密钥不在这个文件里，用 wrangler 管理：
#   npx wrangler secret put ADMIN_PASSWORD
#   npx wrangler secret put GITHUB_TOKEN
#   npx wrangler secret put COMMENT_IP_SALT
# 详见 apps/admin/docs/SETUP.md 与 DEPLOY.md。
