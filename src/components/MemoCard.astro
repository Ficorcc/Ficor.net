---
import { getMemoAnchorId, type MemoItem } from '../lib/memos';
import { createWithBase, formatDateTime } from '../utils/format';
import { getThemeSettings } from '../lib/theme-settings';

const { memo, html = '' } = Astro.props as {
  memo: MemoItem;
  html?: string;
};

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const { settings } = getThemeSettings();
const authorName = (settings.page.bits.defaultAuthor.name ?? 'Whono').trim() || 'Whono';
const authorAvatarRaw = (settings.page.bits.defaultAuthor.avatar ?? '').trim();
const authorAvatar = authorAvatarRaw ? withBase(authorAvatarRaw) : '';
const avatarLetter = Array.from(authorName)[0] ?? 'W';
---

<article class="bit-card bit-card--memo" id={getMemoAnchorId(memo.id)} data-bit data-bit-key={`memo-${memo.id}`}>
  <div class="bit-author">
    <div class={`avatar${authorAvatar ? ' avatar--image' : ' is-fallback'}`} aria-hidden="true">
      {authorAvatar ? (
        <img
          src={authorAvatar}
          alt=""
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
          onerror="this.parentElement?.classList.add('is-fallback'); this.remove();"
        />
      ) : null}
      <span class="avatar-fallback">{avatarLetter}</span>
    </div>
    <div class="name">{authorName}</div>
  </div>

  <div class="bit-body" set:html={html} />

  <div class="bit-meta">
    <div class="bit-tags">
      <span class="bit-tag bit-tag--source">说说</span>
    </div>
    <div>{formatDateTime(memo.date)}</div>
  </div>
</article>
