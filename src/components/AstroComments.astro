---
interface Props {
  pageId?: string;
  pageTitle?: string;
  apiBase?: string;
}

const {
  pageId = Astro.url.pathname,
  pageTitle = typeof Astro.props.pageTitle === "string" ? Astro.props.pageTitle : "",
  apiBase = "/admin/api/comments/",
} = Astro.props;
---

<section
  class="ac-comments"
  data-astro-comments
  data-page-id={pageId}
  data-page-title={pageTitle}
  data-api-base={apiBase}
>
  <h2 class="ac-count" data-count>正在载入评论...</h2>

  <form class="ac-form" data-form>
    <div class="ac-row">
      <label class="ac-field">
        <span class="ac-label">
          昵称<span class="ac-required" aria-hidden="true">*</span>
        </span>
        <input
          name="authorName"
          autocomplete="name"
          maxlength="80"
          placeholder="必填"
          required
        />
      </label>
      <label class="ac-field">
        <span class="ac-label">
          邮箱<span class="ac-required" aria-hidden="true">*</span>
        </span>
        <input
          name="authorEmail"
          type="email"
          autocomplete="email"
          placeholder="必填"
          required
        />
      </label>
      {/* 网址选填：后端 normalizeUrl 会做校验，空值落 null */}
      <label class="ac-field">
        <span class="ac-label">网址</span>
        <input
          name="authorUrl"
          type="url"
          autocomplete="url"
          maxlength="200"
          placeholder="https://example.com"
        />
      </label>
    </div>

    {/* 反垃圾蜜罐：视觉隐藏（CSS display:none），正常人不会填；
        一旦有值，后端在 insertComment 之前直接返回 202 丢弃。
        字段名必须是 website，与 +server.ts 里的判断对应，不要改名或删除。 */}
    <label class="ac-honeypot" aria-hidden="true">
      <span>Website</span>
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>

    <label class="ac-field">
      <span class="ac-sr-only">评论内容</span>
      <textarea
        name="content"
        rows="5"
        minlength="2"
        maxlength="4000"
        placeholder="欢迎评论"
        required
      ></textarea>
    </label>

    <div class="ac-actions">
      <button type="submit">提交评论</button>
    </div>
    <p class="ac-message" data-message role="status"></p>
  </form>

  <ol class="ac-list" data-list></ol>
</section>

<script>
  // @ts-nocheck
  const escapeHtml = (value) =>
    String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  const formatDate = (value) =>
    new Intl.DateTimeFormat(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));

  function renderComment(comment) {
    const safeUrl = /^https?:\/\//i.test(comment.authorUrl || "") ? comment.authorUrl : "";
    const author = safeUrl
      ? `<a href="${escapeHtml(safeUrl)}" rel="nofollow noopener" target="_blank">${escapeHtml(comment.authorName)}</a>`
      : escapeHtml(comment.authorName);

    return `
      <li class="ac-item" data-comment-id="${escapeHtml(comment.id)}">
        <div class="ac-meta">
          <strong>${author}</strong>
          <span>${escapeHtml(comment.level.label)} · ${formatDate(comment.createdAt)}</span>
        </div>
        <p>${escapeHtml(comment.content).replaceAll("\n", "<br>")}</p>
      </li>
    `;
  }

  async function mountComments(root) {
    if (!(root instanceof HTMLElement) || root.dataset.mounted) return;
    root.dataset.mounted = "true";

    const list = root.querySelector<HTMLOListElement>("[data-list]");
    const count = root.querySelector<HTMLElement>("[data-count]");
    const form = root.querySelector<HTMLFormElement>("[data-form]");
    const message = root.querySelector<HTMLElement>("[data-message]");
    if (
      !(list instanceof HTMLElement) ||
      !(count instanceof HTMLElement) ||
      !(form instanceof HTMLFormElement) ||
      !(message instanceof HTMLElement)
    ) {
      return;
    }

    const pageId = root.dataset.pageId || window.location.pathname;
    const pageTitle = root.dataset.pageTitle || document.title;
    const apiBase = root.dataset.apiBase || "/admin/api/comments/";
    const submitButton = form.querySelector('button[type="submit"]');

    function applySettings(settings) {
      if (!settings) return;
      if (submitButton && settings.submitLabel) submitButton.textContent = settings.submitLabel;
      form.hidden = settings.commentsEnabled === false;
      if (settings.commentsEnabled === false) {
        message.textContent = "评论已关闭。";
      }
    }

    async function load() {
      const response = await fetch(`${apiBase}?pageId=${encodeURIComponent(pageId)}`);
      if (!response.ok) throw new Error("Failed to load comments.");
      const data = await response.json();
      applySettings(data.settings);
      const comments = Array.isArray(data.comments) ? data.comments : [];
      list.innerHTML = comments.length
        ? comments.map(renderComment).join("")
        : `<li class="ac-empty">${escapeHtml(data.settings?.emptyText || "还没有评论。")}</li>`;
      count.textContent = `${comments.length} 条评论`;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      message.textContent = "正在提交...";

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      payload.pageId = pageId;
      payload.pageTitle = pageTitle;

      if (submitButton) submitButton.disabled = true;
      try {
      const response = await fetch(apiBase, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        message.textContent = data.error || "提交失败，请稍后再试。";
        return;
      }

      form.reset();
      message.textContent = data.message || "评论已提交。";
      if (data.comment) await load();
      } catch { message.textContent = "网络错误，请稍后再试。"; }
      finally { if (submitButton) submitButton.disabled = false; }
    });

    try {
      await load();
    } catch {
      count.textContent = "评论暂时无法载入";
    }
  }

  const mountAll = () => document.querySelectorAll("[data-astro-comments]").forEach(mountComments);
  mountAll();
  document.addEventListener("astro:page-load", mountAll);
</script>

<style>
  .ac-comments {
    border-top: 1px solid var(--border);
    color: var(--text);
    margin: 48px auto 0;
    max-width: 760px;
    padding-top: 24px;
  }

  /* 阅读模式下正文列宽放宽到 860px，评论区跟着自适应，避免比正文窄一截 */
  :global(body.immersive-page[data-reading="immersive"]) .ac-comments {
    max-width: none;
  }

  /* 表单 */
  .ac-form {
    display: grid;
    gap: 16px;
  }

  .ac-row {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ac-field {
    display: grid;
    gap: 8px;
  }

  .ac-label {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .ac-required {
    color: var(--accent);
    margin-left: 2px;
  }

  /* 视觉隐藏但保留给读屏（textarea 需要一个 label） */
  .ac-sr-only {
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .ac-form input,
  .ac-form textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    padding: 9px 12px;
    transition: border-color 0.15s ease;
    width: 100%;
  }

  .ac-form input::placeholder,
  .ac-form textarea::placeholder {
    color: var(--faint);
  }

  /* 与 global.css 里 a:focus-visible 的约定保持一致 */
  .ac-form input:focus,
  .ac-form textarea:focus {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .ac-form textarea {
    line-height: 1.7;
    resize: vertical;
  }

  .ac-actions {
    display: flex;
    justify-content: flex-end;
  }

  .ac-form button {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    min-width: 88px;
    padding: 8px 20px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .ac-form button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ac-form button:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .ac-message {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .ac-message:empty {
    display: none;
  }

  /* 评论数：位于分割线下方、表单上方 */
  .ac-count {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 20px;
  }

  /* 评论列表 */
  .ac-list {
    display: grid;
    gap: 14px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .ac-item {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px;
  }

  .ac-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .ac-meta a {
    color: inherit;
  }

  .ac-meta span,
  .ac-empty {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .ac-item p {
    line-height: 1.7;
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* 反垃圾蜜罐：必须保持不可见 */
  .ac-honeypot {
    display: none;
  }

  /* 三列排不下时改成单列堆叠 */
  @media (max-width: 700px) {
    .ac-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .ac-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
